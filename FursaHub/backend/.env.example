# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/fursahub

# Auth
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (optional, for follow-up notifications)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Fursahub <no-reply@fursahub.org>"
